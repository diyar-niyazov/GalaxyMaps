# SpaceMaps server configuration. Copy to `.env` and fill in values.
# The map, search, routing and calculations work without any of these.

# xAI API key (https://console.x.ai). Kept server-side only; the browser only
# ever receives short-lived ephemeral tokens for Grok Voice.
XAI_API_KEY=

# Optional overrides.
XAI_VOICE_MODEL=grok-voice-latest
XAI_VOICE_NAME=eve
XAI_IMAGE_MODEL=grok-imagine-image-2.0
# Mission Control text model. Leave empty to pick a fast Grok text model from your account.
XAI_CHAT_MODEL=

# Port for the API server (Vite dev server proxies /api to it).
PORT=8787
